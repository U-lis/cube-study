# cube-study 푸시 발송 — 환경별 인스턴스 (cube-study-push@prod · cube-study-push@dev). #33
# 설치: deploy/push-install.sh (root 1회). 코드는 앱 배포(deploy.sh)가 서버 저장소를
# 갱신하면 따라온다 — 유닛을 다시 깔 필요가 없다.
#
# `%h` 는 `User=` 가 있는 system 유닛에서 서비스 매니저의 홈(`/root`)으로 풀린다
# (man systemd.unit, specifiers 표). 그래서 홈은 `__HOME__` 으로 두고 설치 때 치환한다.
# 같은 이유로 bigsix 의 유닛도 이렇게 생겼다.
[Unit]
Description=cube-study push sender (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ulismoon
Group=ulismoon
# 릴레이가 소유한 키 파일(600). 같은 사용자로 돌아야 읽힌다.
# 인스턴스 이름(prod/dev)이 릴레이 환경 디렉터리 이름과 같아 템플릿 하나로 양쪽을 덮는다.
EnvironmentFile=__HOME__/apps/push-relay/%i/data/keys/cube-study.env
WorkingDirectory=__HOME__/apps/cube-study
ExecStart=__NODE__ --experimental-strip-types __HOME__/apps/cube-study/cron/push.ts tick --instance %i
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cube-study-push-%i
# 1분 안에 끝나야 다음 tick 과 겹치지 않는다. 릴레이가 1000건에 60초를 목표로 한다.
TimeoutStartSec=55
NoNewPrivileges=true
